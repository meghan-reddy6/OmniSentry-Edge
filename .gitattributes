# ==========================================
# Git LFS Tracked AI Models and Large Assets
# ==========================================

# ONNX Models (YOLOv8, MediaPipe Face, Whisper)
*.onnx filter=lfs diff=lfs merge=lfs -text
models/*.onnx filter=lfs diff=lfs merge=lfs -text
models/*.data filter=lfs diff=lfs merge=lfs -text

# GGUF / GGML LLM Binaries (Qwen, LLaMA)
*.gguf filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
models/*.gguf filter=lfs diff=lfs merge=lfs -text
models/*.bin filter=lfs diff=lfs merge=lfs -text

# NumPy Arrays / Model Weights / Safetensors
*.npy filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text

# Media / Audio Assets (WAV, MP3, PNG, JPG)
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text

# ==========================================
# Line Ending Normalization (Cross-Platform)
# ==========================================
* text=auto eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.md text